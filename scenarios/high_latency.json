{
  "name": "high_latency",
  "description": "GNSS timestamps are periodically delayed to exercise warning and critical communication-latency checks.",
  "default_duration_s": 20,
  "random_seed": 4102,
  "sensor_rates_hz": {"GNSS": 5.0, "IMU": 20.0, "BATTERY": 1.0, "VEHICLE_STATUS": 2.0},
  "motion": {
    "forward_speed_mps": 1.4,
    "lateral_amplitude_m": 8.0,
    "lateral_period_s": 24.0,
    "secondary_amplitude_m": 1.8,
    "secondary_period_s": 7.0,
    "vertical_amplitude_m": 1.0,
    "vertical_period_s": 20.0,
    "battery_drain_percent_per_s": 0.03
  },
  "quality": {"position_noise_std_m": 0.04, "confidence": 0.97},
  "faults": {
    "timing_fault_sensor_types": ["GNSS"],
    "delay_every_n_messages": 8,
    "delay_ms": 2500
  },
  "annotations": [
    {
      "event_type": "HIGH_LATENCY",
      "start_s": 1.0,
      "end_s": 20.0,
      "severity": "CRITICAL",
      "description": "Every eighth GNSS message carries a 2.5 second timestamp delay."
    }
  ]
