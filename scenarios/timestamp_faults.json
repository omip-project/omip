{
  "name": "timestamp_faults",
  "description": "GNSS periodically reports a regressed timestamp and a timestamp ahead of the server clock.",
  "default_duration_s": 24,
  "random_seed": 4103,
  "sensor_rates_hz": {"GNSS": 5.0, "IMU": 20.0, "BATTERY": 1.0, "VEHICLE_STATUS": 2.0},
  "motion": {
    "forward_speed_mps": 1.4,
    "lateral_amplitude_m": 8.0,
    "lateral_period_s": 24.0,
    "secondary_amplitude_m": 1.8,
    "secondary_period_s": 7.0,
    "vertical_amplitude_m": 1.0,
    "vertical_period_s": 20.0,
    "battery_drain_percent_per_s": 0.03
  },
  "quality": {"position_noise_std_m": 0.04, "confidence": 0.97},
  "faults": {
    "timing_fault_sensor_types": ["GNSS"],
    "timestamp_regression_every_n_messages": 30,
    "timestamp_regression_ms": 3000,
    "future_timestamp_every_n_messages": 45,
    "future_timestamp_ms": 12000
  },
  "annotations": [
    {
      "event_type": "TIMESTAMP_FAULTS",
      "start_s": 1.0,
      "end_s": 24.0,
      "severity": "WARNING",
      "description": "GNSS clock regression and future-timestamp faults are injected periodically."
    }
  ]
}
