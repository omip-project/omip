# Copy this file to .env before customising deployment settings.

# Bind to 127.0.0.1 for local-only access.
# Use 0.0.0.0 only for a trusted LAN and configure the host firewall.
OMIP_BIND_ADDRESS=127.0.0.1

OMIP_HTTP_PORT=8000
OMIP_MQTT_PORT=1883
OMIP_IMAGE_TAG=local

OMIP_ONLINE_THRESHOLD_S=5
OMIP_DEGRADED_THRESHOLD_S=15

# Optional demo simulator profile.
OMIP_DEMO_VEHICLE_ID=OMIP-DEMO-UGV-001
OMIP_DEMO_VEHICLE_TYPE=GROUND_VEHICLE
OMIP_DEMO_VEHICLE_PROFILE=ugv-small-ackermann-v1
OMIP_DEMO_SCENARIO=scenarios/ugv_active_avoidance.json
OMIP_DEMO_RANDOM_SEED=42
OMIP_DEMO_DURATION_S=60
